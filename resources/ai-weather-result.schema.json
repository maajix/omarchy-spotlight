{
  "type": "object",
  "properties": {
    "kind": { "type": "string", "enum": ["answer", "command", "steps"] },
    "text": { "type": "string" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": { "type": "string" },
          "explanation": { "type": "string" }
        },
        "required": ["command", "explanation"],
        "additionalProperties": false
      }
    },
    "weather": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["weather"] },
            "variant": { "type": "string", "enum": ["current", "rain", "forecast"] },
            "location": { "type": "string" },
            "sourceUrl": { "type": "string" },
            "days": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": { "type": "string" },
                  "summary": { "type": "string" },
                  "temperatureC": { "type": ["number", "null"] },
                  "lowC": { "type": ["number", "null"] },
                  "highC": { "type": ["number", "null"] },
                  "rainPercent": { "type": ["number", "null"] }
                },
                "required": ["date", "summary", "temperatureC", "lowC", "highC", "rainPercent"],
                "additionalProperties": false
              }
            }
          },
          "required": ["type", "variant", "location", "sourceUrl", "days"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "type": "string", "enum": ["unavailable"] } },
          "required": ["type"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["kind", "text", "commands", "weather"],
  "additionalProperties": false
}
