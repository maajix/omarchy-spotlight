#!/usr/bin/env python3
"""Bounded I/O broker for the Spotlight overlay.

Spotlight is a `keepLoaded` plugin: it lives inside the long-running
omarchy-shell process. Anything that process reads stays resident, so no read
may be open-ended. Every file read, every subprocess and every write that
Spotlight needs goes through this helper instead of happening in QML, and each
one is bounded three ways before the shell ever sees a byte:

  * a hard ceiling on how much is read,
  * a wall-clock deadline with a TERM -> KILL process-group teardown,
  * a normalised, count-limited projection as the only thing printed.

Every subcommand prints exactly one JSON object on stdout and exits 0. Failure
is `{"ok": false, "error": ...}` — the caller falls back to its defaults, so a
hostile or broken input degrades the feature instead of the shell.

Directories are opened as verified descriptors (owned by us, not group- or
world-writable) and every step of a path is opened relative to the previous
descriptor, so no ancestor can be swapped between the check and the use.
Directory components may be symlinks — `~/.config` pointing into a dotfiles
repo is a normal setup — but the descriptor they resolve to still has to pass
the ownership check. File components are opened O_NOFOLLOW and must be regular
files owned by us, which is what keeps a planted symlink, FIFO or device out.
"""

import errno
import fcntl
import hashlib
import json
import os
import re
import select
import shutil
import signal
import socket
import stat
import subprocess
import sys
import time

EUID = os.geteuid()
ACTIVE_PROC = None

# ------------------------------------------------------------------ limits
SETTINGS_BYTES = 64 * 1024
USAGE_BYTES = 256 * 1024
CLIPBOARD_BYTES = 8 * 1024 * 1024
ICS_BYTES = 64 * 1024

USAGE_VERSION = 2
USAGE_KEEP = 400
USAGE_FILE_KEEP = 100
USAGE_CONTEXT_KEEP = 128
USAGE_CONTEXT_HIT_KEEP = 8
USAGE_JSON_BUDGET_BYTES = 200000
USAGE_ID_CHARS = 512
USAGE_CONTEXT_CHARS = 256
USAGE_ID_RE = re.compile(r"^(?:(?:app|window|action):[^\x00-\x1f]{1,505}|file:[0-9a-f]{64})$")
USAGE_CONTEXT_RE = re.compile(
    r"^(?:query:|filter:(?:app|window|file|action|clipboard|web|calc|unit|reminder|calendar):)"
    r"[^\x00-\x1f]{2,220}$"
)

CLIP_ENTRIES = 200
CLIP_TITLE_CHARS = 120
CLIP_TEXT_BYTES = 1024 * 1024

SUGGEST_BYTES = 64 * 1024
SUGGEST_DEADLINE = 3.0
SUGGEST_COUNT = 8
SUGGEST_CHARS = 200
SUGGEST_QUERY_CHARS = 200

FILES_BYTES = 256 * 1024
FILES_DEADLINE = 3.0
# The shell ranks and shows only the best few of these, so this is a scan
# pool, not a display count: raising it costs `fd` little (its own walk
# dominates the latency, not the result cap) but is what lets a real match
# survive being buried behind everything a bare directory walk happens to
# find first. 400 short paths sits well under FILES_BYTES.
FILES_COUNT = 400
FILES_PATH_CHARS = 1024
FILES_PATTERN_CHARS = 256
FILES_MAX_TERMS = 8
# Each row repeats its path across path/name/dir plus JSON structure, so 400
# short real-world hits (35-50 KB raw from `fd`) can still project into a
# payload several times that size — measured able to clear Spotlight.qml's
# maxHelperPayloadChars (524288) well before hitting FILES_COUNT, on long
# real paths. This stops row-building on real (not estimated) JSON size,
# comfortably under that ceiling, rather than hoping FILES_COUNT alone keeps
# the payload small enough.
#
# "Comfortably" has to mean at least 2x, not just "under": this is counted
# in Python `len()` (code points), but the ceiling it protects is JS
# `String.length` (UTF-16 code units) on the other side of the JSON — any
# character outside the BMP counts double there and not here. Measured
# break-even against a real emit() of a payload that is nearly all
# non-BMP: ~265000. 200000 keeps that difference from ever mattering —
# raising this constant without re-deriving that margin reintroduces the
# empty-results bug this budget exists to prevent.
FILES_JSON_BUDGET_CHARS = 200000

REMINDER_BYTES = 256 * 1024
REMINDER_DEADLINE = 3.0

TOGGLE_BYTES = 8 * 1024
TOGGLE_DEADLINE = 1.0
REMINDER_COUNT = 50
REMINDER_FIELD_CHARS = 200

TLDR_BYTES = 64 * 1024
# The first lookup of a page downloads it, so this is generous for a launcher.
TLDR_DEADLINE = 4.0
TLDR_EXAMPLES = 16
TLDR_FIELD_CHARS = 512
TLDR_PAGE_RE = re.compile(r"^[a-z0-9][a-z0-9._+-]{0,63}$")
# `{{[-a|--all]}}` is an option alternation; the long form reads best.
TLDR_OPTION_RE = re.compile(r"\{\{\[[^|\]]*\|([^\]]*)\]\}\}")
TLDR_URL_RE = re.compile(r"More information: <(https?://[^>\s]+)>")
# tldr marks the option letter as in "[c]reate"; a heading reads better plain.
TLDR_HINT_RE = re.compile(r"\[(\w)\]")

ICS_STAMP_RE = re.compile(r"^[0-9TZ]{1,32}$")

# ~/.config/hypr/bindings.lua is edited only through a delimited block at EOF
# plus a distinctive comment prefix on the line it replaces, so the whole
# edit reverts byte for byte (cmd_revert_binding).
BINDINGS_BYTES = 256 * 1024
# Whether a chord is free is a question about the compositor, so it is asked
# of the compositor: Hyprland's IPC socket answers `j/binds` with its live
# bind table. The socket is what fails when Hyprland is unreachable, and
# failing is the point - `omarchy-menu-keybindings --print` formats a menu
# and still exits 0 printing only its static entries when the dynamic query
# dies, which reads downstream as "every other chord is free".
#
# The socket alone is not complete: Hyprland 0.56 reports `key: ""` for the
# 59 binds its text mode spells `SUPER + code:10`, so chords named by
# keycode are invisible in JSON and their keycodes are not exposed either.
# --print resolves those against the active keymap, so it is merged in - but
# only to *add* chords, and only once the socket has already answered. A
# short --print can then subtract from the table; it can never turn an
# occupied chord into a free one.
HYPR_SOCKET_NAME = ".socket.sock"
HYPR_BINDS_BYTES = 4 * 1024 * 1024
HYPR_BINDS_DEADLINE = 2.0
# Hyprland's modmask bits for the modifiers a chord here can name.
HYPR_MODMASK = ((1, "SHIFT"), (4, "CTRL"), (8, "ALT"), (64, "SUPER"))
BINDINGS_PRINT_BYTES = 64 * 1024
BINDINGS_PRINT_DEADLINE = 3.0
BINDINGS_DESC_CHARS = 120
MARK_START = '-- >>> spotlight setup tour (managed; rerun via "Run Setup Tour") >>>'
MARK_END = "-- <<< spotlight setup tour <<<"
DISABLED_PREFIX = "-- spotlight-tour:disabled "
TOGGLE_CMD = "omarchy-shell shell toggle io.github.maajix.spotlight '{}'"
# A live line binding the bare Spotlight toggle; group 1 is the chord
# literal. A bind carrying a query payload is a different shortcut and is
# left alone.
TOGGLE_RE = re.compile(
    r'''^\s*o\.bind\(\s*(?P<chord_quote>["'])(?P<chord>[^"']+)(?P=chord_quote)\s*,.*?'''
    r'''(?P<command_quote>["'])omarchy-shell shell toggle io\.github\.maajix\.spotlight'''
    r'''(?:\s+["']?\{\}["']?)?(?P=command_quote)\s*[,)]''')
UNBIND_RE = re.compile(r'''^\s*hl\.unbind\(\s*["']([^"']+)["']\s*\)''')
CHORD_MODS = ("SUPER", "CTRL", "ALT", "SHIFT")
CHORD_ALIASES = {"WIN": "SUPER", "LOGO": "SUPER", "MOD4": "SUPER",
                 "CONTROL": "CTRL", "MOD1": "ALT"}
# Canonical chord as written into bindings.lua: modifiers in CHORD_MODS
# order, then exactly one key.
CHORD_RE = re.compile(
    r"^(?:SUPER \+ )?(?:CTRL \+ )?(?:ALT \+ )?(?:SHIFT \+ )?"
    r"(?:[A-Z0-9]|SPACE|RETURN|TAB|F(?:[1-9]|1[0-2])|UP|DOWN|LEFT|RIGHT|BACKSPACE|DELETE|PRINT)$")

# The packaged list of desktop ids Omarchy keeps out of its own launcher.
# It lives under /usr/share, so it is the one read that is not ours: root
# owns it, and root is the only other owner any read here will accept.
OMARCHY_FALLBACK_PATH = "/usr/share/omarchy"
HIDES_PARTS = ("default", "omarchy")
HIDES_NAME = "launcher.hides"
HIDES_BYTES = 64 * 1024
HIDES_COUNT = 400
HIDES_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$")
SYSTEM_OWNERS = (0, EUID)

# The real Omarchy root-menu tree (JSONC: default + a user-writable
# extension, merged the same way Menu.qml's own MenuModel.js does - later
# entries override earlier fields, not whole entries). Read-only: nothing
# here is ever written back.
MENU_PARTS = ("default", "omarchy")
MENU_NAME = "omarchy-menu.jsonc"
MENU_USER_PARTS = (".config", "omarchy", "extensions")
MENU_JSONC_BYTES = 256 * 1024
MENU_MAX_ITEMS = 400
MENU_SKIP_PREFIXES = ("install.", "remove.", "system.")
# Known collisions with lib/Commands.js's own curated entries, found by
# review, not by construction (no general dedup pass exists - a title match
# alone cannot tell "same command, different label" from "different command,
# same label"). learn.keybindings duplicates the curated `keys` row exactly;
# trigger.screensaver is worse than a duplicate - it *toggles* an active
# screensaver off, while the curated row *starts* one, so the same title
# would mean opposite things depending on which row a user happened to
# click. Extend this list as more surface; it is not a promise of
# completeness.
# trigger.toggle.screensaver, not trigger.screensaver - found by review, a
# typo'd id here means the skip is a no-op (the tautological form of "not
# in this list" that a test asserting against the list itself cannot catch:
# it passes for a nonexistent id just as easily as for a real one). Verify
# skip decisions against the emitted title set, not against this list.
# setup.keybindings is included for the same collision reason but a
# different resolution (see its own comment at the callsite) - it survives
# the curated `keys` row's title but does something different (edits
# bindings.lua rather than viewing keybindings), so it is dropped rather
# than mislabeled.
MENU_SKIP_IDS = ("learn.keybindings", "trigger.toggle.screensaver", "setup.keybindings")
# Only omarchy's own wrapped commands - the same posture Commands.js already
# committed to (its own comment: no Suspend row, because a bare `systemctl
# suspend` would cost the marketplace listing its automatic Verified status).
# Pulling the menu tree in wholesale would silently reintroduce exactly that
# without this gate: the tree's own system.suspend/system.hibernate entries
# call `systemctl` directly. (In practice system.* is excluded above anyway -
# Commands.js already curates that whole subtree by hand - but the gate holds
# even if that changes.)
MENU_ACTION_PREFIX = "omarchy-"
MENU_ARGV_TOKENS = 12
MENU_ARGV_CHARS = 512
MENU_LABEL_CHARS = 200
MENU_BREADCRUMB_DEPTH = 6
# Each ancestor label is clamped before joining into a subtitle - a leaf's
# own label is bounded by MENU_LABEL_CHARS, but an *ancestor* label, shared
# by every one of its descendants, was not bounded at all: found by review,
# a single oversized ancestor label (real risk only via the user's own
# extension file, but still real) multiplies across every child under it and
# can blow well past the JSON budget below on its own.
MENU_BREADCRUMB_LABEL_CHARS = 60
MENU_PKG_LIST_DEADLINE = 2.0
MENU_PKG_LIST_BYTES = 512 * 1024
# Same reasoning as bin/spotlight-helper's file-search budget (see
# FILES_JSON_BUDGET_CHARS): row count alone does not bound serialized JSON
# size, and Spotlight.qml rejects the whole reply above maxHelperPayloadChars
# (524288) - found by review, a single very long ancestor label (see
# MENU_BREADCRUMB_LABEL_CHARS above) was enough to build a 400-item reply
# past that ceiling from a 22 KB source file. This stops row-building on
# real (not estimated) JSON size directly; margin reasoning matches
# FILES_JSON_BUDGET_CHARS's comment (Python len() vs JS String.length).
MENU_JSON_BUDGET_CHARS = 200000
# Shell metacharacters that only mean anything when they appear outside of
# any quoting - found by review (round 2), rejecting them unconditionally
# (a plain regex over the raw string, run before tokenising) meant a
# perfectly literal, harmless value inside quotes - a URL query string like
# 'https://x/?a=1&b=2' - silently vanished from the catalogue too, the same
# false-negative failure this module otherwise goes out of its way to
# avoid. ';'/'<'/'>'/newline/backslash/backtick are rejected the same way,
# even though real Bash would also reject some of these unquoted forms
# outright - the point here is never to guess at shell semantics, so an
# unquoted occurrence of any of them is treated as "this needs a real
# shell" rather than parsed further.
MENU_UNQUOTED_REJECT_CHARS = frozenset("|&;()<>`\\*?{}[]#\n")
# Bash's own default word separators (IFS), not Python's broader isspace() -
# found by review, isspace() is also true for \r/\v/\f, which Bash treats as
# ordinary characters *inside* a word, not separators; using it here split
# one argument into two on any of those three, the same class of bug as the
# \n-consumed-by-isspace() regression, just narrower (an escape a real
# extension author would have to write on purpose, not something a CRLF
# line ending in the JSON source could ever trigger - the \r there sits
# outside the parsed string value).
MENU_WORD_SEP = " \t"
# Reserved words are only shell syntax in command position, but this module
# does not track command position - rejecting them as bare, wholly-unquoted
# tokens (never inside quotes, where they are ordinary literal arguments)
# is the conservative stand-in used instead.
MENU_SHELL_KEYWORDS = frozenset({"if", "then", "elif", "fi"})
# A '$' only starts a real expansion when followed by something that could
# begin one (a name, `{`, `(`, or a Bash special parameter) - anything else
# right after it (end of string, a closing quote, punctuation) is a literal
# dollar sign in real Bash too. Needed to correctly handle the quote-
# concatenation trick found by review: `'$'HOME/a` is a single-quoted
# literal `$` immediately followed by unquoted `HOME/a` (no `$` in front of
# it, so no expansion) - Bash's own word-joining rule glues these into one
# token, `$HOME/a`, entirely literal. A naive "does the joined token
# contain $HOME" check (this module's previous approach) cannot tell that
# apart from a real `$HOME` reference and expanded it wrongly.
MENU_DOLLAR_EXPANSION_CHARS = frozenset(
    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_{(@*#?$!-0123456789"
)
MENU_WHEN_PKG_RE = re.compile(r"^(!\s*)?omarchy-pkg-present\s+(\S+)$")
MENU_WHEN_CMD_RE = re.compile(r"^(!\s*)?omarchy-cmd-present\s+(\S+)$")
# The path may be quoted the normal Bash way (`[[ -d "$HOME/foo" ]]`, or,
# for a path containing a space, has to be) - found by review, treating the
# quotes as part of the path made every quoted condition evaluate as though
# the path did not exist; matched as two alternatives (quoted allows spaces,
# unquoted does not) rather than one pattern, since a real entry in the
# shipped tree quotes a path with a space in it. Group 3 is the quote
# character itself (or None if unquoted) - _menu_when_allows uses it to
# decide whether $HOME/~ inside the path may be expanded at all.
MENU_WHEN_PATH_RE = re.compile(r'^\[\[\s*(!\s*)?-([df])\s+(?:(["\'])(.*?)\3|(\S+))\s*\]\]$')
# $HOME must end at a word boundary - found by review, a plain substring
# replace turned $HOMEDIR (a different, unrelated variable name that merely
# starts with the same four letters) into a fabricated path instead of
# being left as an unresolved $ and rejected.
MENU_HOME_VAR_RE = re.compile(r"\$HOME\b")


class Denied(Exception):
    """Any boundary violation. Always fails closed."""


# ------------------------------------------------------------ descriptors
def _verify_dir(fd, label, owners=(EUID,)):
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode):
        raise Denied("%s is not a directory" % label)
    if st.st_uid not in owners:
        raise Denied("%s is not owned by an accepted user" % label)
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise Denied("%s is group- or world-writable" % label)


def home_fd():
    home = os.environ.get("HOME", "")
    if not home.startswith("/"):
        raise Denied("HOME is not an absolute path")
    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        _verify_dir(fd, "HOME")
    except Exception:
        os.close(fd)
        raise
    return fd


def dir_at(parent, name, create=False):
    """Open `name` under `parent` as a verified directory descriptor."""
    if create:
        try:
            os.mkdir(name, 0o700, dir_fd=parent)
        except FileExistsError:
            pass
        except OSError as exc:
            raise Denied("cannot create %s: %s" % (name, exc.strerror))
    fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC, dir_fd=parent)
    try:
        _verify_dir(fd, name)
    except Exception:
        os.close(fd)
        raise
    return fd


def walk(parts, create=False):
    """Resolve a chain of directory names below $HOME, one descriptor at a time."""
    fd = home_fd()
    for part in parts:
        nxt = dir_at(fd, part, create=create)
        os.close(fd)
        fd = nxt
    return fd


def system_dir(path):
    """Open an absolute system directory, verifying every component in turn.

    Same walk as walk(), one descriptor per component so no ancestor can be
    swapped between the check and the use, with root allowed as an owner
    alongside us. Nothing outside Omarchy's own install prefix is read this
    way, and nothing read this way is ever written.
    """
    if not path.startswith("/"):
        raise Denied("system path is not absolute")
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        _verify_dir(fd, "/", SYSTEM_OWNERS)
        for part in [p for p in path.split("/") if p]:
            if part == "..":
                raise Denied("system path escapes upward")
            nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = nxt
            _verify_dir(fd, part, SYSTEM_OWNERS)
    except Exception:
        os.close(fd)
        raise
    return fd


def read_file(dirfd, name, cap, owners=(EUID,)):
    """Read at most `cap` bytes from a regular file we own, never following a symlink."""
    try:
        # O_NONBLOCK so a FIFO planted at this name cannot block the open
        # itself; the S_ISREG check below then rejects it outright.
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                     dir_fd=dirfd)
    except FileNotFoundError:
        return None
    except OSError as exc:
        if exc.errno in (errno.ELOOP, errno.EMLINK):
            raise Denied("%s is a symlink" % name)
        raise Denied("cannot open %s: %s" % (name, exc.strerror))
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Denied("%s is not a regular file" % name)
        if st.st_uid not in owners:
            raise Denied("%s is not owned by an accepted user" % name)
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            raise Denied("%s is group- or world-writable" % name)
        if st.st_size > cap:
            raise Denied("%s is larger than %d bytes" % (name, cap))
        os.set_blocking(fd, True)
        chunks = []
        total = 0
        while total <= cap:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            total += len(chunk)
            chunks.append(chunk)
        if total > cap:
            raise Denied("%s grew past %d bytes while reading" % (name, cap))
        return b"".join(chunks)
    finally:
        os.close(fd)


def read_json(dirfd, name, cap, fallback):
    raw = read_file(dirfd, name, cap)
    if raw is None:
        return fallback
    try:
        return json.loads(raw.decode("utf-8", "replace"))
    except ValueError:
        return fallback


def lock_at(dirfd, name):
    """An exclusive advisory lock on a regular file we own. Never truncates."""
    fd = os.open(name, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
                 0o600, dir_fd=dirfd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != EUID:
            raise Denied("%s is not a regular file owned by this user" % name)
        fcntl.flock(fd, fcntl.LOCK_EX)
    except Exception:
        os.close(fd)
        raise
    return fd


def write_atomic(dirfd, name, payload, mode=0o600):
    """Publish `payload` at `name` by renaming a private temp, dir-fd-relatively."""
    tmp = ".%s.tmp.%d" % (name, os.getpid())
    try:
        os.unlink(tmp, dir_fd=dirfd)
    except FileNotFoundError:
        pass
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                 0o600, dir_fd=dirfd)
    try:
        view = memoryview(payload)
        while view:
            view = view[os.write(fd, view):]
        os.fchmod(fd, mode)
        os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.replace(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)
    except Exception:
        try:
            os.unlink(tmp, dir_fd=dirfd)
        except OSError:
            pass
        raise
    os.fsync(dirfd)


def write_new(dirfd, name, payload):
    """Create one private regular file without replacing an existing name."""
    try:
        fd = os.open(name,
                     os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                     0o600, dir_fd=dirfd)
    except FileExistsError:
        read_file(dirfd, name, SETTINGS_BYTES)
        return False
    try:
        view = memoryview(payload)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
    finally:
        os.close(fd)
    os.fsync(dirfd)
    return True


# ------------------------------------------------------------ subprocesses
def run_bounded(argv, cap, deadline, stdin_bytes=None, want_status=False):
    """Run `argv`, returning at most `cap` bytes of stdout within `deadline`.

    The child gets its own session, so the deadline tears down the whole
    process group rather than just the leader — an `fd` descendant cannot
    outlive the call. Reaching either bound is not
    an error: the caller works with the bounded prefix.

    `want_status` adds the child's exit status to the tuple. A caller that
    reads absence in the output as a fact about the world needs it: a
    command that runs and fails writes nothing, which is indistinguishable
    from a command that ran and found nothing. None means it never exited
    on its own and the teardown took it.
    """
    global ACTIVE_PROC
    blocked = {signal.SIGINT, signal.SIGTERM}
    old_mask = signal.pthread_sigmask(signal.SIG_BLOCK, blocked)
    try:
        proc = subprocess.Popen(
            argv,
            stdin=subprocess.PIPE if stdin_bytes is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        ACTIVE_PROC = proc
    except OSError as exc:
        raise Denied("cannot run %s: %s" % (argv[0], exc.strerror))
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)

    out = proc.stdout
    try:
        if stdin_bytes is not None:
            try:
                proc.stdin.write(stdin_bytes)
            except OSError:
                pass
            try:
                proc.stdin.close()
            except OSError:
                pass

        fd = out.fileno()
        os.set_blocking(fd, False)
        end = time.monotonic() + deadline
        chunks = []
        total = 0
        truncated = False

        while True:
            remaining = end - time.monotonic()
            if remaining <= 0:
                truncated = True
                break
            ready, _, _ = select.select([fd], [], [], min(remaining, 0.25))
            if not ready:
                continue
            try:
                chunk = os.read(fd, 65536)
            except BlockingIOError:
                continue
            except OSError:
                break
            if not chunk:
                break
            room = cap - total
            if len(chunk) >= room:
                chunks.append(chunk[:room])
                truncated = True
                break
            chunks.append(chunk)
            total += len(chunk)
        result = (b"".join(chunks), truncated)
    finally:
        _reap(proc)
        if ACTIVE_PROC is proc:
            ACTIVE_PROC = None
        try:
            out.close()
        except OSError:
            pass
    if want_status:
        return result[0], result[1], proc.returncode
    return result


def _reap(proc):
    """TERM the whole process group, then KILL it, then wait. Never leaves a child."""
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except OSError:
        if proc.poll() is None:
            try:
                proc.terminate()
            except OSError:
                pass
    try:
        proc.wait(timeout=0.5)
    except subprocess.TimeoutExpired:
        pass

    # Always address the group once more: its leader may have exited while a
    # descendant remains alive with the same process-group id.
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except OSError:
        if proc.poll() is None:
            try:
                proc.kill()
            except OSError:
                pass
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        pass


def _handle_termination(signum, _frame):
    proc = ACTIVE_PROC
    if proc is not None:
        _reap(proc)
    raise SystemExit(128 + signum)


# --------------------------------------------------------------- clamping
def clamp_text(value, chars):
    s = "" if value is None else str(value)
    s = "".join(ch for ch in s if ch == "\t" or ch >= " " or ch == "\n")
    return s[:chars]


def clamp_int(value, low, high, default):
    try:
        n = int(value)
    except (TypeError, ValueError):
        return default
    return max(low, min(high, n))


def clamp_bool(value, default):
    return bool(value) if isinstance(value, bool) else default


def read_stdin(cap):
    data = sys.stdin.buffer.read(cap + 1)
    if len(data) > cap:
        raise Denied("stdin exceeded %d bytes" % cap)
    return data


def emit(payload):
    payload["ok"] = True
    sys.stdout.write(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))
    sys.stdout.write("\n")


# ------------------------------------------------------------- normalizers
def normalize_settings(parsed):
    out = {
        "webSuggestions": False,
        "searchEngine": "g",
        "fileSearch": True,
        "fileSearchAlways": True,
        "clipboardSearch": True,
        "clipboardSearchAlways": True,
        "learningEnabled": True,
        "maxResults": 20,
        "maxApps": 8,
        "maxSuggestions": 4,
        "setupCompleted": False,
    }
    if not isinstance(parsed, dict):
        return out
    out["webSuggestions"] = clamp_bool(parsed.get("webSuggestions"), False)
    out["setupCompleted"] = clamp_bool(parsed.get("setupCompleted"), False)
    out["fileSearch"] = clamp_bool(parsed.get("fileSearch"), True)
    out["fileSearchAlways"] = clamp_bool(parsed.get("fileSearchAlways"), True)
    out["clipboardSearch"] = clamp_bool(parsed.get("clipboardSearch"), True)
    out["clipboardSearchAlways"] = clamp_bool(parsed.get("clipboardSearchAlways"), True)
    out["learningEnabled"] = clamp_bool(parsed.get("learningEnabled"), True)
    out["maxResults"] = clamp_int(parsed.get("maxResults"), 8, 50, 20)
    out["maxApps"] = clamp_int(parsed.get("maxApps"), 3, 24, 8)
    out["maxSuggestions"] = clamp_int(parsed.get("maxSuggestions"), 0, SUGGEST_COUNT, 4)
    engine = parsed.get("searchEngine")
    if isinstance(engine, str) and re.match(r"^[A-Za-z]{1,8}$", engine):
        out["searchEngine"] = engine.lower()
    return out


def normalize_usage(parsed):
    """Normalize V2 learning data and migrate the old flat usage map."""
    if not isinstance(parsed, dict):
        parsed = {}
    now = int(time.time() * 1000)
    is_v2 = parsed.get("version") == USAGE_VERSION
    source = parsed.get("items", {}) if is_v2 else parsed
    if not isinstance(source, dict):
        source = {}

    candidates = []
    for source_key, value in list(source.items())[:USAGE_KEEP * 4]:
        key = source_key
        if not is_v2:
            if isinstance(key, str) and key.startswith("cmd:"):
                key = "action:" + key[4:]
            elif not isinstance(key, str) or not key.startswith("app:"):
                continue
        if not isinstance(key, str) or len(key) > USAGE_ID_CHARS or not USAGE_ID_RE.match(key):
            continue
        if not isinstance(value, dict):
            continue
        count = clamp_int(value.get("count"), 0, 1000000, 0)
        last = clamp_int(value.get("last"), 0, now + 86400000, 0)
        if count <= 0:
            continue
        entry = {"count": count, "last": last}
        if key.startswith("file:"):
            meta = value.get("meta")
            path = meta.get("path") if isinstance(meta, dict) else None
            if (not isinstance(path, str) or not path.startswith("/")
                    or len(path) > FILES_PATH_CHARS or path_fingerprint(path) != key[5:]
                    or not os.path.exists(path)):
                continue
            entry["meta"] = {
                "path": path,
                "name": clamp_text(os.path.basename(path), 512),
                "dir": clamp_text(os.path.dirname(path) or "/", FILES_PATH_CHARS),
                "isDir": os.path.isdir(path),
            }
        candidates.append((key, entry))

    candidates.sort(key=lambda item: (-item[1]["last"], -item[1]["count"], item[0]))
    items = {}
    files = 0
    for key, entry in candidates:
        if key.startswith("file:"):
            files += 1
            if files > USAGE_FILE_KEEP:
                continue
        if len(items) >= USAGE_KEEP:
            break
        items[key] = entry

    contexts = []
    raw_contexts = parsed.get("contexts", {}) if is_v2 else {}
    if isinstance(raw_contexts, dict):
        for context_key, raw_hits in list(raw_contexts.items())[:USAGE_CONTEXT_KEEP * 4]:
            if (not isinstance(context_key, str) or len(context_key) > USAGE_CONTEXT_CHARS
                    or not USAGE_CONTEXT_RE.match(context_key) or not isinstance(raw_hits, dict)):
                continue
            hits = []
            for item_id, value in list(raw_hits.items())[:USAGE_CONTEXT_HIT_KEEP * 4]:
                if item_id not in items or not isinstance(value, dict):
                    continue
                count = clamp_int(value.get("count"), 0, 1000000, 0)
                last = clamp_int(value.get("last"), 0, now + 86400000, 0)
                if count > 0:
                    hits.append((item_id, {"count": count, "last": last}))
            hits.sort(key=lambda item: (-item[1]["last"], -item[1]["count"], item[0]))
            kept_hits = dict(hits[:USAGE_CONTEXT_HIT_KEEP])
            if kept_hits:
                contexts.append((context_key, kept_hits,
                                 max(hit["last"] for hit in kept_hits.values())))
    contexts.sort(key=lambda item: (-item[2], item[0]))
    out = {
        "version": USAGE_VERSION,
        "items": items,
        "contexts": {key: hits for key, hits, _ in contexts[:USAGE_CONTEXT_KEEP]},
    }

    # Count limits normally fit comfortably; the serialized-byte check is the
    # final hard stop for long paths and context keys.
    while len(json.dumps(out, ensure_ascii=False, separators=(",", ":")).encode("utf-8")) > USAGE_JSON_BUDGET_BYTES:
        if out["contexts"]:
            out["contexts"].pop(next(reversed(out["contexts"])))
        elif out["items"]:
            dropped = next(reversed(out["items"]))
            out["items"].pop(dropped)
        else:
            break
    return out


def path_fingerprint(path):
    return hashlib.sha256(path.encode("utf-8", "surrogatepass")).hexdigest()


# ------------------------------------------------------------- omarchy menu
def _menu_strip_jsonc(raw):
    """JSONC -> JSON: line comments and trailing commas, nothing else.

    Same two transformations as MenuModel.js's own stripJsonc, so a file the
    real menu accepts parses here the same way - not the identical regexes
    (this one keeps the trailing newline the JS version consumes), just the
    same net effect on any real menu file.
    """
    text = raw.decode("utf-8", "replace") if raw is not None else ""
    text = re.sub(r"^[ \t]*//[^\n]*$", "", text, flags=re.M)
    text = re.sub(r",(\s*[}\]])", r"\1", text)
    return text


def _menu_normalize_item(item_id, entry):
    """Same normalization MenuModel.js's own normalizeItem does, applied per
    source, before merging with the other one - not after.

    Every recognised field is always present here (empty string/list when
    the source did not set it), which is what makes the merge in
    _menu_merge correct: an extension entry that reuses an id to turn an
    action into a link (sets `target`, does not repeat `action`) has to
    actually clear the inherited action, not just add `target` next to it.
    Found by review: merging un-normalized dicts kept the old action alive
    under the new label, because a field simply absent from the override
    never overwrote the default's value for that field. `kind` is computed
    here, per source, for the same reason `action`/`target` are - it is
    itself just another field that the later source's own normalization
    overwrites on merge, exactly matching what the real menu does.
    """
    aliases = entry.get("aliases")
    if isinstance(aliases, list):
        aliases = [a for a in aliases if isinstance(a, str) and a]
    elif isinstance(aliases, str) and aliases:
        aliases = [aliases]
    else:
        aliases = []
    parent = entry.get("parent")
    if not isinstance(parent, str):
        if item_id == "root":
            parent = ""
        elif "." in item_id:
            parent = item_id.rsplit(".", 1)[0]
        else:
            parent = "root"
    action = entry.get("action")
    action = action if isinstance(action, str) else ""
    target = entry.get("target")
    target = target if isinstance(target, str) else ""
    label = entry.get("label")
    label = label if isinstance(label, str) and label else item_id
    return {
        "parent": parent,
        "kind": "action" if action else ("link" if target else "menu"),
        "icon": entry.get("icon") if isinstance(entry.get("icon"), str) else "",
        "label": label,
        "target": target,
        "action": action,
        "provider": entry.get("provider") if isinstance(entry.get("provider"), str) else "",
        "aliases": aliases,
        "when": entry.get("when") if isinstance(entry.get("when"), str) else "",
    }


def _menu_parse_items(raw):
    """Raw JSONC bytes -> {id: normalized-entry-dict}. Never raises; bad
    input is empty.
    """
    text = _menu_strip_jsonc(raw)
    if not text.strip():
        return {}
    try:
        parsed = json.loads(text)
    except ValueError:
        return {}
    if not isinstance(parsed, dict):
        return {}
    source = parsed.get("items") if isinstance(parsed.get("items"), dict) else parsed
    out = {}
    for item_id, entry in source.items():
        if not isinstance(item_id, str) or not isinstance(entry, dict):
            continue
        out[item_id] = _menu_normalize_item(item_id, entry)
    return out


def _menu_read_default():
    base = os.environ.get("OMARCHY_PATH", "").strip() or OMARCHY_FALLBACK_PATH
    fd = system_dir(base.rstrip("/") + "/" + "/".join(MENU_PARTS))
    try:
        return read_file(fd, MENU_NAME, MENU_JSONC_BYTES, SYSTEM_OWNERS)
    finally:
        os.close(fd)


def _menu_read_user():
    """The user's own extension file. Its directory is allowed not to exist
    yet - most users never touch this - which is not the same failure as a
    directory that exists but fails ownership/permission checks, so only the
    former is swallowed here.
    """
    try:
        fd = walk(list(MENU_USER_PARTS))
    except FileNotFoundError:
        return None
    try:
        return read_file(fd, MENU_NAME, MENU_JSONC_BYTES)
    finally:
        os.close(fd)


def _menu_merge(default_items, user_items):
    """Field-by-field merge, later source wins - same semantics as
    MenuModel.js's mergeMenuSources: reusing an id extends/overrides it, it
    does not replace it outright.
    """
    merged = {}
    order = []
    for source in (default_items, user_items):
        for item_id, entry in source.items():
            if item_id not in merged:
                order.append(item_id)
                merged[item_id] = {}
            merged[item_id].update(entry)
    return merged, order


def _menu_title(label, argv):
    restart = any(os.path.basename(token).startswith("omarchy-restart-") for token in argv)
    return "Restart " + label if restart and not label.lower().startswith("restart") else label


def _menu_breadcrumb(item_id, merged):
    """Ancestor labels, root-to-parent, joined for a subtitle - `Style ›
    Font` rather than a bare `Font`, since dozens of leaves share generic
    labels (`Default`, `Theme`, `Chrome`) that only their place in the tree
    disambiguates. Each ancestor label is clamped on its own - unlike a
    leaf's own label, an ancestor's is shared by every descendant under it,
    so one oversized label found here multiplies across a whole subtree
    rather than costing one row.
    """
    parts = []
    seen = set()
    current = merged.get(item_id, {}).get("parent", "")
    while current and current != "root" and current not in seen and len(parts) < MENU_BREADCRUMB_DEPTH:
        seen.add(current)
        entry = merged.get(current)
        if not entry:
            break
        label = entry.get("label")
        if isinstance(label, str) and label:
            parts.append(clamp_text(label, MENU_BREADCRUMB_LABEL_CHARS))
        current = entry.get("parent", "")
    parts.reverse()
    return " › ".join(parts)


def _menu_dollar_home(action, i):
    """True when action[i] starts a word-bounded `$HOME` - the only
    variable this module ever expands."""
    if action[i:i + 5] != "$HOME":
        return False
    nxt = action[i + 5:i + 6]
    return not (nxt.isalnum() or nxt == "_")


def _menu_dollar_is_literal(action, i):
    """True when the '$' at action[i] cannot start a real Bash expansion -
    nothing follows it that could ever begin one - so it is just a literal
    dollar sign, exactly as real Bash would treat it, quoted or not."""
    nxt = action[i + 1:i + 2]
    return not nxt or nxt not in MENU_DOLLAR_EXPANSION_CHARS


def _menu_tokenize(action):
    """A minimal, quote-aware tokeniser standing in for a real shell lexer.

    Found by review across two rounds: neither a regex run over the raw
    action string before tokenising, nor a per-token check run on shlex's
    output afterwards, can correctly tell quoted (literal) text apart from
    unquoted (meaningful) text - shlex.split discards quote type once it
    hands back plain strings, and Bash's own quote-concatenation rule
    (`'$'HOME` is one token made of a literal `$` plus unquoted `HOME`,
    with no expansion) lets a single quoted character disguise the rest of
    a token as unquoted to any check working from the outside in. This
    walks the string exactly once, tracking real quote state per character,
    so every substitution and rejection decision is made with that context
    instead of a guess: $HOME expands inside double quotes and unquoted
    text (real Bash's own rule), never inside single quotes; ~ expands only
    at the true start of an unquoted word; and shell metacharacters/
    keywords are rejected only where they appear outside of any quoting,
    since that is the only place a real shell would ever treat them as
    syntax rather than as literal text.

    Returns a list of argv tokens with $HOME/~ already resolved, or None if
    the action needs real shell semantics this does not implement.
    """
    home = os.environ.get("HOME", "")
    tokens = []
    chars = []
    token_quoted = False
    at_token_start = True
    quote = None
    i, n = 0, len(action)
    while i < n:
        c = action[i]
        if quote == "'":
            if c == "'":
                quote = None
            else:
                chars.append(c)
            i += 1
            continue
        if quote == '"':
            if c == '"':
                quote = None
                i += 1
                continue
            if c == "$":
                if _menu_dollar_home(action, i):
                    chars.append(home)
                    i += 5
                    continue
                if _menu_dollar_is_literal(action, i):
                    chars.append("$")
                    i += 1
                    continue
                return None
            if c in ("`", "\\"):
                return None
            chars.append(c)
            i += 1
            continue
        # unquoted - the reject-char check runs before the word-separator
        # check, not after: \n is a real command separator in Bash, not a
        # word separator, and found by review, checking it as a separator
        # first let it fall through before the reject check ever ran,
        # silently turning a two-command action into one command whose
        # second line became a useless argv token instead of being rejected
        # - byte-for-byte the same failure that reproved the very first
        # round of this feature.
        if c in MENU_UNQUOTED_REJECT_CHARS:
            return None
        if c in MENU_WORD_SEP:
            if chars or token_quoted:
                tokens.append(("".join(chars), token_quoted))
                chars = []
                token_quoted = False
            at_token_start = True
            i += 1
            continue
        if c == "'":
            quote = "'"
            token_quoted = True
            at_token_start = False
            i += 1
            continue
        if c == '"':
            quote = '"'
            token_quoted = True
            at_token_start = False
            i += 1
            continue
        if c == "~":
            if at_token_start:
                # Only the two forms this module actually implements: `~`
                # alone (the whole word) or a `~/...` path. `~user`
                # (another user's home), `~+` ($PWD) and `~-` ($OLDPWD) are
                # real Bash tilde forms too - found by review, expanding any
                # leading ~ unconditionally fabricated a path for these
                # instead (`~+` became literally "$HOME+"). Reject rather
                # than guess, the same policy already applied to every other
                # unsupported construct in this function.
                nxt = action[i + 1:i + 2]
                if nxt == "" or nxt in MENU_WORD_SEP or nxt == "/":
                    chars.append(home)
                    at_token_start = False
                    i += 1
                    continue
                return None
            # Bash also expands a tilde after the `=` (and `:`) of some
            # assignment-shaped words: `x=~/a` becomes `x=$HOME/a`. This
            # lexer does not track the full assignment grammar, so keeping
            # such a tilde literal can silently change an argument. Reject
            # every non-leading unquoted tilde rather than guessing whether
            # Bash would expand it; quoted tildes remain ordinary literals.
            return None
        if c == "$":
            # $'...' (ANSI-C quoting) and $"..." (locale quoting) are real
            # Bash constructs this module does not implement - found by
            # review, treating the $ as a literal dollar sign here (as it
            # correctly is inside already-open double quotes, where a `'`
            # has no special meaning) accepted the action with the wrong
            # argument instead of rejecting the construct: `$'abc'` means
            # the single argument "abc" in Bash, not a literal "$" followed
            # by a separately-quoted "abc".
            if action[i + 1:i + 2] in ("'", '"'):
                return None
            if _menu_dollar_home(action, i):
                chars.append(home)
                at_token_start = False
                i += 5
                continue
            if _menu_dollar_is_literal(action, i):
                chars.append("$")
                at_token_start = False
                i += 1
                continue
            return None
        chars.append(c)
        at_token_start = False
        i += 1
    if quote is not None:
        return None  # unterminated quote
    if chars or token_quoted:
        tokens.append(("".join(chars), token_quoted))
    resolved = []
    for text, quoted in tokens:
        if not quoted and text in MENU_SHELL_KEYWORDS:
            return None
        resolved.append(text)
    return resolved


def _menu_resolve_argv(action):
    """A config-supplied command line -> an argv vector, or None if it
    can't be one without a real shell. Never returns something that was
    not built by _menu_tokenize - no string is ever handed to a shell
    here.
    """
    action = str(action or "").strip()
    if not action:
        return None
    argv = _menu_tokenize(action)
    if not argv or len(argv) > MENU_ARGV_TOKENS:
        return None
    for token in argv:
        if len(token) > MENU_ARGV_CHARS:
            return None
    if not argv[0].startswith(MENU_ACTION_PREFIX):
        return None
    return argv


_INSTALLED_PACKAGES = "unread"


def _menu_installed_packages():
    """`pacman -Qq` once per process, cached - answers every `omarchy-pkg-
    present` check in `when` without a subprocess per entry.

    Returns None, not a partial set, if the listing was truncated: a package
    past the cut would silently read as "not installed" (or "installed", if
    the condition is negated) with no error and no visible sign the answer
    is wrong - exactly the false-negative-hides-a-feature failure the rest
    of this module is written to avoid. 25x headroom on this machine today
    (~21 KB against a 512 KB cap), but the check costs nothing to keep.
    """
    global _INSTALLED_PACKAGES
    if _INSTALLED_PACKAGES != "unread":
        return _INSTALLED_PACKAGES
    raw, truncated = run_bounded(["pacman", "-Qq"], MENU_PKG_LIST_BYTES, MENU_PKG_LIST_DEADLINE)
    _INSTALLED_PACKAGES = None if truncated else frozenset(raw.decode("utf-8", "replace").split())
    return _INSTALLED_PACKAGES


def _menu_when_allows(when):
    """Only a handful of declarative `when` shapes are answered here - a
    package or command present, a path existing - each resolved without a
    shell (a package-name lookup, a PATH search, a stat). Every other shape
    (hardware probes, `compgen`, arbitrary shell) is left showing rather
    than hidden: a row nobody's hardware can use is a dead click, a row that
    silently disappeared is a feature the user cannot find and cannot know
    why - worse in a launcher.
    """
    when = str(when or "").strip()
    if not when:
        return True

    m = MENU_WHEN_PKG_RE.match(when)
    if m:
        installed = _menu_installed_packages()
        if installed is None:
            return True  # truncated listing: unknown, not "not installed"
        present = m.group(2) in installed
        return (not present) if m.group(1) else present

    m = MENU_WHEN_CMD_RE.match(when)
    if m:
        present = shutil.which(m.group(2)) is not None
        return (not present) if m.group(1) else present

    m = MENU_WHEN_PATH_RE.match(when)
    if m:
        negate, kind, quote_char = m.group(1), m.group(2), m.group(3)
        path = m.group(4) if quote_char else m.group(5)
        home = os.environ.get("HOME", "")
        # $HOME expands inside double quotes and unquoted text, never
        # inside single quotes; ~ never expands under any quoting, only
        # unquoted - found by review, the previous version expanded both
        # regardless of which quote (if any) wrapped the path, so
        # `[[ ! -d '$HOME' ]]` (meant literally) silently tested the real
        # home directory instead of the string "$HOME".
        if quote_char != "'":
            if home:
                path = MENU_HOME_VAR_RE.sub(home, path)
            if quote_char is None and (path == "~" or path.startswith("~/")):
                path = home + path[1:]
        exists = os.path.isdir(path) if kind == "d" else os.path.isfile(path)
        return (not exists) if negate else exists

    return True


def _menu_commands():
    """The real Omarchy root-menu tree, projected into the same row shape
    Commands.js already emits - Spotlight.qml's dispatch does not need to
    know these came from a different source. install.*/remove.* (package
    management, not what a launcher's fuzzy search is for, and the single
    largest source of `when` conditions) and system.* (already curated by
    hand in Commands.js, confirmation prompts included) are excluded by
    subtree; MENU_SKIP_IDS excludes specific known collisions with that same
    curated catalogue; a `provider` entry pulls its rows from a runtime
    function/command rather than static data and is excluded rather than
    guessed at; an `action` this cannot turn into a plain argv vector is
    excluded rather than run through a shell.
    """
    default_items = _menu_parse_items(_menu_read_default())
    user_items = _menu_parse_items(_menu_read_user())
    merged, order = _menu_merge(default_items, user_items)

    rows = []
    json_chars = 0
    for item_id in order:
        if len(rows) >= MENU_MAX_ITEMS:
            break
        if item_id.startswith(MENU_SKIP_PREFIXES) or item_id in ("install", "remove", "system"):
            continue
        if item_id in MENU_SKIP_IDS:
            continue
        entry = merged[item_id]
        # kind, not a bare truthy `action` check: both are set together by
        # the same source's normalization, so this is the field the merge
        # above actually promises is in sync with the rest of the entry.
        if entry.get("kind") != "action":
            continue
        if entry.get("provider"):
            continue
        argv = _menu_resolve_argv(entry.get("action"))
        if not argv:
            continue
        if not _menu_when_allows(entry.get("when")):
            continue
        label = clamp_text(entry.get("label") or item_id, MENU_LABEL_CHARS)
        if not label:
            continue
        aliases = entry.get("aliases")
        keywords = " ".join(a for a in aliases if isinstance(a, str)) if isinstance(aliases, list) else ""
        row = {
            "key": "menu:" + item_id,
            "title": _menu_title(label, argv),
            "subtitle": _menu_breadcrumb(item_id, merged),
            "icon": clamp_text(entry.get("icon") or "", 8),
            "argv": argv,
            "keywords": clamp_text(keywords, MENU_LABEL_CHARS),
        }
        # Real serialized size, not a row count, is what actually has to
        # stay under Spotlight.qml's maxHelperPayloadChars - see
        # MENU_JSON_BUDGET_CHARS. A single very long ancestor label was
        # enough to build an oversized reply well under MENU_MAX_ITEMS.
        row_chars = len(json.dumps(row, ensure_ascii=False, separators=(",", ":")))
        if rows and json_chars + row_chars > MENU_JSON_BUDGET_CHARS:
            break
        json_chars += row_chars
        rows.append(row)
    return rows


# ---------------------------------------------------------------- commands
def cmd_read_settings():
    try:
        fd = walk([".config", "omarchy"])
    except FileNotFoundError:
        emit({"settings": normalize_settings({})})
        return
    try:
        parsed = read_json(fd, "spotlight.json", SETTINGS_BYTES, {})
    finally:
        os.close(fd)
    emit({"settings": normalize_settings(parsed)})


def cmd_ensure_settings():
    settings = normalize_settings({})
    payload = (json.dumps(settings, indent=2) + "\n").encode("utf-8")
    fd = walk([".config", "omarchy"], create=True)
    try:
        write_new(fd, "spotlight.json", payload)
    finally:
        os.close(fd)
    emit({"path": os.path.join(os.environ["HOME"], ".config", "omarchy", "spotlight.json")})


def cmd_ensure_data():
    fd = walk([".local", "state", "omarchy"], create=True)
    os.close(fd)
    emit({"path": os.path.join(os.environ["HOME"], ".local", "state", "omarchy")})


def cmd_reset_usage():
    try:
        fd = walk([".local", "state", "omarchy"])
    except FileNotFoundError:
        emit({"reset": True})
        return
    try:
        if read_file(fd, "spotlight-usage.json", USAGE_BYTES) is not None:
            os.unlink("spotlight-usage.json", dir_fd=fd)
            os.fsync(fd)
    finally:
        os.close(fd)
    emit({"reset": True})


def cmd_read_hides():
    """The desktop ids Omarchy keeps out of its own launcher.

    Omarchy's AppLibrary filters these before it hands a list to the menu.
    When the shell withholds that library, Spotlight builds the list itself
    and has to apply the same filter, or it shows a page of entries the menu
    has always hidden.
    """
    base = os.environ.get("OMARCHY_PATH", "").strip() or OMARCHY_FALLBACK_PATH
    fd = system_dir(base.rstrip("/") + "/" + "/".join(HIDES_PARTS))
    try:
        raw = read_file(fd, HIDES_NAME, HIDES_BYTES, SYSTEM_OWNERS)
    finally:
        os.close(fd)

    hides = []
    for line in (raw or b"").decode("utf-8", "replace").splitlines():
        value = line.strip()
        if value.endswith(".desktop"):
            value = value[:-8]
        if HIDES_ID_RE.match(value):
            hides.append(value)
        if len(hides) >= HIDES_COUNT:
            break
    emit({"hides": hides})


def cmd_read_menu_commands():
    emit({"commands": _menu_commands()})


def cmd_read_usage():
    fd = walk([".local", "state", "omarchy"], create=True)
    try:
        raw = read_file(fd, "spotlight-usage.json", USAGE_BYTES)
        try:
            parsed = json.loads(raw.decode("utf-8", "replace")) if raw is not None else {}
        except ValueError:
            parsed = {}
        usage = normalize_usage(parsed)
        if raw is not None and parsed != usage:
            lock = lock_at(fd, ".spotlight-usage.lock")
            try:
                write_atomic(fd, "spotlight-usage.json",
                             json.dumps(usage, separators=(",", ":")).encode("utf-8"))
            finally:
                os.close(lock)
    finally:
        os.close(fd)
    emit({"usage": usage})


def cmd_write_usage():
    raw = read_stdin(USAGE_BYTES)
    try:
        parsed = json.loads(raw.decode("utf-8", "replace")) if raw else {}
    except ValueError:
        raise Denied("usage payload is not JSON")
    usage = normalize_usage(parsed)
    payload = json.dumps(usage, separators=(",", ":")).encode("utf-8")

    fd = walk([".local", "state", "omarchy"], create=True)
    try:
        lock = lock_at(fd, ".spotlight-usage.lock")
        try:
            write_atomic(fd, "spotlight-usage.json", payload)
        finally:
            os.close(lock)
    finally:
        os.close(fd)
    emit({"written": len(usage["items"])})


def _clipboard_entries():
    try:
        fd = walk([".local", "state", "omarchy"])
    except FileNotFoundError:
        return []
    try:
        parsed = read_json(fd, "clipboard-history.json", CLIPBOARD_BYTES, [])
    finally:
        os.close(fd)
    if not isinstance(parsed, list):
        return []
    out = []
    for item in parsed:
        if len(out) >= CLIP_ENTRIES:
            break
        if not isinstance(item, dict) or item.get("type") != "text":
            continue
        text = item.get("text")
        if not isinstance(text, str) or not text.strip():
            continue
        out.append(text)
    return out


def cmd_read_clipboard():
    """Titles only.

    The full clipboard text is deliberately left on disk: a history holding
    tokens and passwords has no business being resident in a shell process
    that outlives the query. `clipboard-copy` re-reads the one entry the user
    picked and pipes it straight to wl-copy, so it never crosses this boundary.
    """
    entries = _clipboard_entries()
    rows = []
    for index, text in enumerate(entries):
        flat = re.sub(r"\s+", " ", text).strip()
        if not flat:
            continue
        title = flat[:CLIP_TITLE_CHARS] + ("…" if len(flat) > CLIP_TITLE_CHARS else "")
        rows.append({"index": index, "title": title, "bytes": len(text.encode("utf-8"))})
    emit({"items": rows})


def cmd_clipboard_copy(argv):
    if len(argv) != 2:
        raise Denied("clipboard-copy takes an index and a title")
    index = clamp_int(argv[0], 0, CLIP_ENTRIES - 1, -1)
    if index < 0:
        raise Denied("bad clipboard index")
    entries = _clipboard_entries()
    if index >= len(entries):
        raise Denied("clipboard entry is gone")
    text = entries[index]
    # The history may have shifted between listing and activation, so the row
    # the user actually saw is re-identified by its title before anything is
    # put on the clipboard.
    flat = re.sub(r"\s+", " ", text).strip()
    expected = flat[:CLIP_TITLE_CHARS] + ("…" if len(flat) > CLIP_TITLE_CHARS else "")
    if expected != argv[1]:
        raise Denied("clipboard entry changed")
    payload = text.encode("utf-8")[:CLIP_TEXT_BYTES]
    # Not run_bounded: wl-copy forks a daemon that has to outlive this call in
    # order to serve the selection, and tearing down the process group would
    # take that daemon with it. A plain bounded wait on the parent is right
    # here — the input is a fixed size and the argv has no operands at all.
    try:
        subprocess.run(["wl-copy"], input=payload, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Denied("wl-copy failed: %s" % type(exc).__name__)
    emit({"copied": len(payload)})


def cmd_reminders():
    raw, _ = run_bounded(["omarchy-reminder", "show", "--json"],
                         REMINDER_BYTES, REMINDER_DEADLINE)
    try:
        parsed = json.loads(raw.decode("utf-8", "replace")) if raw else {}
    except ValueError:
        parsed = {}
    items = parsed.get("reminders") if isinstance(parsed, dict) else None
    rows = []
    if isinstance(items, list):
        for item in items[:REMINDER_COUNT]:
            if not isinstance(item, dict):
                continue
            rows.append({
                "label": clamp_text(item.get("label"), REMINDER_FIELD_CHARS),
                "remaining": clamp_text(item.get("remaining"), REMINDER_FIELD_CHARS),
                "atTime": clamp_text(item.get("atTime"), REMINDER_FIELD_CHARS),
            })
    emit({"reminders": rows})


# ------------------------------------------------------------ toggle states
# Omarchy keeps most toggles as a flag file, and most of those flags record the
# *off* state (`bar-off`), so which way the file reads is part of the table.
# state id -> (path relative to $HOME, does the file existing mean "on")
TOGGLE_FLAGS = {
    "idle":         (".local/state/omarchy/indicators/stay-awake", True),
    "bar":          (".local/state/omarchy/toggles/bar-off", False),
    "screensaver":  (".local/state/omarchy/toggles/screensaver-off", False),
    "suspend":      (".local/state/omarchy/toggles/suspend-off", False),
    "crashcapture": (".local/state/omarchy/toggles/crash-capture-off", False),
    "touchpad":     (".local/state/omarchy/toggles/hypr/touchpad-disabled-name", False),
    "touchscreen":  (".local/state/omarchy/toggles/hypr/touchscreen-disabled-name", False),
    "gaps":         (".local/state/omarchy/toggles/hypr/window-no-gaps.lua", False),
    "aspect":       (".local/state/omarchy/toggles/hypr/single-window-aspect-ratio.lua", True),
}


def _tri(text, on_token, off_token):
    return {on_token: True, off_token: False}.get(text.strip().lower())


def _probe_json(text, key):
    try:
        parsed = json.loads(text)
    except ValueError:
        return None
    return parsed.get(key) if isinstance(parsed, dict) else None


def _probe_bluetooth(text):
    # The soft block is the state Omarchy persists (see omarchy-bluetooth-power),
    # so read the block rather than BlueZ: no D-Bus round trip, and it survives
    # a reboot the same way the setting does.
    for line in text.splitlines():
        if line.startswith("bluetooth"):
            return line.split()[-1] == "unblocked"
    return None


def _probe_nightlight(text):
    value = _probe_json(text, "enabled")
    return value if isinstance(value, bool) else None


def _probe_mic(text):
    # wpctl always prints "Volume: <n>", and appends "[MUTED]" when muted.
    if "volume" not in text.lower():
        return None
    return "muted" not in text.lower()


def _run_probe(argv, test):
    raw, _ = run_bounded(argv, TOGGLE_BYTES, TOGGLE_DEADLINE)
    return test(raw.decode("utf-8", "replace").strip())


def _cmd_probe(argv, test):
    return lambda: _run_probe(argv, test)


def _probe_fullscreen(text):
    # `fullscreenClient == 2` is the state omarchy-hyprland-window-tiled-
    # fullscreen-toggle sets, and it is the focused window's, not the session's:
    # Spotlight is a layer surface, so the window behind it stays the active one.
    value = _probe_json(text, "fullscreenClient")
    return value == 2 if isinstance(value, int) else None


def _probe_scrolling(text):
    # Dwindle and scrolling are the only two layouts the toggle cycles, so
    # "scrolling is on" is the whole state rather than half of it.
    value = _probe_json(text, "tiledLayout")
    return _tri(value, "scrolling", "dwindle") if isinstance(value, str) else None


def _probe_opaque(text):
    # `opaque` is a per-window override, absent from the window's own JSON and
    # readable only through getprop. Opaque on is transparency off.
    value = _probe_json(text, "opaque")
    return (not value) if isinstance(value, bool) else None


def _probe_battery_percent():
    """The bar writes this one into its own entry in shell.json, so the state
    is the layout entry rather than a flag file or a command."""
    # cmd_toggle_states turns a Denied or an OSError here into "unknown", which
    # is the right answer for a home or a config this helper cannot read.
    fd = walk([".config", "omarchy"])
    try:
        parsed = read_json(fd, "shell.json", SETTINGS_BYTES, None)
    finally:
        os.close(fd)
    bar = parsed.get("bar") if isinstance(parsed, dict) else None
    layout = bar.get("layout") if isinstance(bar, dict) else None
    if not isinstance(layout, dict):
        return None
    for side in ("left", "center", "right"):
        for entry in layout.get(side) or []:
            if isinstance(entry, dict) and entry.get("id") == "omarchy.power":
                return entry.get("showPercentage") is True
    # No power module in the bar means nothing to show the percentage on.
    return None


def _probe_speaker():
    """The sink has to be resolved first: DSP sinks mean @DEFAULT_SINK@ is not
    always the device omarchy-audio-output-volume actually mutes."""
    sink, _ = run_bounded(["omarchy-audio-output-sink"], TOGGLE_BYTES, TOGGLE_DEADLINE)
    sink = sink.decode("utf-8", "replace").strip()
    if not sink:
        return None
    return _run_probe(["pactl", "get-sink-mute", sink],
                      lambda t: _tri(t, "mute: no", "mute: yes"))


# state id -> a probe that answers True, False, or None for "cannot tell"
TOGGLE_PROBES = {
    "bluetooth":  _cmd_probe(["rfkill", "--noheadings", "--output", "TYPE,SOFT"], _probe_bluetooth),
    "wifi":       _cmd_probe(["nmcli", "radio", "wifi"], lambda t: _tri(t, "enabled", "disabled")),
    "nightlight": _cmd_probe(["omarchy-toggle-nightlight", "--status"], _probe_nightlight),
    "dnd":        _cmd_probe(["omarchy-shell", "notifications", "dndState"], lambda t: _tri(t, "on", "off")),
    "mic":        _cmd_probe(["wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@"], _probe_mic),
    "speaker":    _probe_speaker,
    "fullscreen": _cmd_probe(["hyprctl", "activewindow", "-j"], _probe_fullscreen),
    "scrolling":  _cmd_probe(["hyprctl", "activeworkspace", "-j"], _probe_scrolling),
    "batterypercent": _probe_battery_percent,
    "transparency": _cmd_probe(
        ["hyprctl", "-j", "getprop", "activewindow", "opaque"], _probe_opaque),
}


def cmd_toggle_states():
    home = os.environ.get("HOME", "")
    states = {}
    if home.startswith("/"):
        for name, (rel, present_is_on) in TOGGLE_FLAGS.items():
            states[name] = os.path.exists(os.path.join(home, rel)) == present_is_on

    # ponytail: probes run one after another, ~300ms worst case off the UI
    # thread; parallelise with Popen if open latency ever shows it.
    for name, probe in TOGGLE_PROBES.items():
        try:
            value = probe()
        except (Denied, OSError, ValueError):
            value = None
        if value is not None:
            states[name] = bool(value)
    emit({"states": states})


def cmd_suggest(argv):
    if len(argv) not in (1, 2):
        raise Denied("suggest takes a query and an optional engine")
    engine = argv[1] if len(argv) == 2 else "g"
    query = clamp_text(argv[0], SUGGEST_QUERY_CHARS).strip()
    if not query:
        emit({"suggestions": []})
        return
    # The endpoint is built here rather than passed in, so nothing upstream can
    # steer the request at a different host. urllib keeps this feature inside
    # Python's standard library; a stock install does not need curl.
    from urllib.error import URLError
    from urllib.parse import quote
    from urllib.request import HTTPRedirectHandler, Request, build_opener

    class NoRedirect(HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None

    endpoint = ("https://kagi.com/api/autosuggest?q=" if engine == "kagi" else
                "https://suggestqueries.google.com/complete/search?client=firefox&hl=en&q=")
    url = endpoint + quote(query, safe="")
    try:
        request = Request(url, headers={"Accept": "application/json", "User-Agent": "Spotlight"})
        with build_opener(NoRedirect).open(request, timeout=SUGGEST_DEADLINE) as response:
            raw = response.read(SUGGEST_BYTES + 1)
    except (OSError, URLError, ValueError):
        raw = b""
    if len(raw) > SUGGEST_BYTES:
        emit({"suggestions": []})
        return
    try:
        parsed = json.loads(raw.decode("utf-8", "replace")) if raw else []
    except ValueError:
        parsed = []
    items = parsed[1] if isinstance(parsed, list) and len(parsed) > 1 else []
    out = []
    if isinstance(items, list):
        for item in items[:SUGGEST_COUNT * 4]:
            if len(out) >= SUGGEST_COUNT:
                break
            if not isinstance(item, str):
                continue
            s = clamp_text(item, SUGGEST_CHARS).strip()
            if s:
                out.append(s)
    emit({"suggestions": out})


def cmd_files(argv):
    if len(argv) != 2:
        raise Denied("files takes a directory and a pattern")
    directory = argv[0]
    pattern = clamp_text(argv[1], FILES_PATTERN_CHARS)
    if not directory.startswith("/") or len(directory) > FILES_PATH_CHARS or not pattern.strip():
        raise Denied("bad file search target")
    try:
        probe = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError:
        emit({"files": []})
        return
    os.close(probe)

    # A query like "PMJ XLS" is two terms a user expects ANDed together (one
    # for the name, one for the extension), not one literal substring — `fd`
    # takes the first positional pattern plus any number of --and patterns,
    # so the split lands directly on its own multi-pattern support (fd >= 9.0).
    #
    # --ignore-case overrides fd's own smart-case, under which a term typed
    # in caps (an extension, an acronym) would otherwise force case-sensitive
    # matching on that one term and silently drop real hits — "XLS" not
    # matching ".xlsx" is what a user actually typing this feature hits.
    # Spotlight, the target this plugin models itself on, is not case
    # sensitive either.
    terms = pattern.split()[:FILES_MAX_TERMS]
    fd_argv = ["fd", "--hidden", "--follow", "--one-file-system", "--ignore-case",
               "--exclude", ".git", "--exclude", "node_modules", "--exclude", ".cache",
               "--max-results", str(FILES_COUNT)]
    for term in terms[1:]:
        fd_argv += ["--and", term]
    fd_argv += ["--", terms[0], directory]

    raw, truncated = run_bounded(fd_argv, FILES_BYTES, FILES_DEADLINE)

    lines = raw.decode("utf-8", "replace").split("\n")
    if truncated:
        # run_bounded truncates two ways - the byte cap, or the deadline
        # tearing the process group down mid-write - and either can land
        # mid-path. Whether that clean-looking last line is really complete
        # or was just cut on a lucky boundary is not knowable from here, so
        # it is dropped rather than risk emitting a path that was never
        # real - one fewer candidate costs nothing this deep in the pool.
        lines = lines[:-1]

    rows = []
    json_chars = 0
    for line in lines:
        if len(rows) >= FILES_COUNT:
            break
        if not line or len(line) > FILES_PATH_CHARS:
            continue
        is_dir = line.endswith("/")
        path = line[:-1] if is_dir else line
        if not path:
            continue
        slash = path.rfind("/")
        name = path[slash + 1:] if slash >= 0 else path
        dirname = path[:slash] if slash > 0 else "/"
        row = {"id": path_fingerprint(path), "path": path, "name": name,
               "dir": dirname, "isDir": is_dir}
        # The real serialized size, not an estimate from raw string lengths:
        # a control character (legal in a Linux filename, not rejected
        # above) expands to a 6-char \uXXXX escape in JSON regardless of
        # ensure_ascii, which a flat "len(path) + overhead" guess does not
        # see coming - confirmed able to blow past FILES_JSON_BUDGET_CHARS
        # on an ASCII-length estimate alone.
        row_chars = len(json.dumps(row, ensure_ascii=False, separators=(",", ":")))
        if rows and json_chars + row_chars > FILES_JSON_BUDGET_CHARS:
            break
        json_chars += row_chars
        rows.append(row)
    emit({"files": rows})


def cmd_tldr(argv):
    if len(argv) != 1:
        raise Denied("tldr takes one page name")
    # `tldr git commit` is the page git-commit; joining here means the name
    # the regex vets is exactly the one that reaches `tldr`.
    page = "-".join(clamp_text(argv[0], TLDR_FIELD_CHARS).lower().split())
    if not TLDR_PAGE_RE.match(page):
        raise Denied("bad tldr page name")
    raw, _ = run_bounded(["tldr", "-m", "--", page], TLDR_BYTES, TLDR_DEADLINE)

    # An unknown page is not an error to the client (exit 0, a one-line
    # notice), so "found" is the presence of the markdown heading.
    title = ""
    description = []
    url = ""
    examples = []
    pending = ""
    for line in raw.decode("utf-8", "replace").split("\n"):
        line = line.strip()
        if line.startswith("# "):
            title = clamp_text(line[2:], TLDR_FIELD_CHARS)
        elif line.startswith("> "):
            match = TLDR_URL_RE.search(line)
            if match:
                url = match.group(1)
            else:
                description.append(line[2:])
        elif line.startswith("- "):
            pending = TLDR_HINT_RE.sub(r"\1", line[2:].rstrip(":")).replace("`", "")
            pending = pending[:1].upper() + pending[1:]
        elif line.startswith("`") and pending and len(examples) < TLDR_EXAMPLES:
            command = TLDR_OPTION_RE.sub(r"\1", line.strip("`")).replace("{{", "").replace("}}", "")
            examples.append({"description": clamp_text(pending, TLDR_FIELD_CHARS),
                             "command": clamp_text(command, TLDR_FIELD_CHARS)})
            pending = ""
    emit({"page": page, "found": bool(title), "title": title,
          "description": clamp_text(" ".join(description), TLDR_FIELD_CHARS),
          "url": url, "examples": examples})


def cmd_write_ics(argv):
    if len(argv) != 1 or not ICS_STAMP_RE.match(argv[0]):
        raise Denied("bad event stamp")
    body = read_stdin(ICS_BYTES)
    if not body:
        raise Denied("empty event")

    downloads = os.environ.get("XDG_DOWNLOAD_DIR", "")
    home = os.environ.get("HOME", "")
    name = "Downloads"
    if downloads.startswith(home + "/") and "/" not in downloads[len(home) + 1:]:
        name = downloads[len(home) + 1:]
    fd = walk([name], create=True)
    try:
        # O_EXCL is the whole symlink defence: a name that already exists —
        # including one that exists only as a dangling symlink — is never
        # opened, it is stepped over.
        for attempt in range(20):
            suffix = "" if attempt == 0 else "-%d" % attempt
            filename = "omarchy-event-%s%s.ics" % (argv[0], suffix)
            try:
                out = os.open(filename,
                              os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                              0o600, dir_fd=fd)
            except FileExistsError:
                continue
            try:
                view = memoryview(body)
                while view:
                    view = view[os.write(out, view):]
                os.fsync(out)
            finally:
                os.close(out)
            emit({"path": os.path.join(home, name, filename)})
            return
        raise Denied("could not find a free filename")
    finally:
        os.close(fd)


def cmd_write_settings():
    """Merge a patch of known keys into spotlight.json; unknown keys on disk survive."""
    raw = read_stdin(SETTINGS_BYTES)
    try:
        patch = json.loads(raw.decode("utf-8", "replace")) if raw else None
    except ValueError:
        patch = None
    if not isinstance(patch, dict):
        raise Denied("settings patch is not a JSON object")
    fd = walk([".config", "omarchy"], create=True)
    try:
        raw = read_file(fd, "spotlight.json", SETTINGS_BYTES)
        try:
            existing = json.loads(raw.decode("utf-8", "replace")) if raw else {}
        except ValueError:
            existing = None
        if not isinstance(existing, dict):
            # A hand edit that no longer parses is never overwritten.
            raise Denied("spotlight.json is not a JSON object")
        known = normalize_settings({})
        for key in known:
            if key in patch:
                existing[key] = patch[key]
        settings = normalize_settings(existing)
        for key in known:
            if key in patch:
                existing[key] = settings[key]
        payload = (json.dumps(existing, indent=2, ensure_ascii=False) + "\n").encode("utf-8")
        if len(payload) > SETTINGS_BYTES:
            raise Denied("spotlight.json would be larger than %d bytes" % SETTINGS_BYTES)
        # ponytail: no lock - Spotlight.qml funnels every write through one
        # Process; wrap in lock_at() if a second writer ever appears.
        write_atomic(fd, "spotlight.json", payload)
    finally:
        os.close(fd)
    emit({"settings": settings})


# ---------------------------------------------------------------- bindings
def _hypr_dir():
    try:
        return walk([".config", "hypr"])
    except FileNotFoundError:
        raise Denied("~/.config/hypr is missing")


def _bindings_lines(dirfd):
    raw = read_file(dirfd, "bindings.lua", BINDINGS_BYTES)
    return None if raw is None else raw.decode("utf-8", "surrogateescape").split("\n")


def _write_bindings(dirfd, lines):
    try:
        mode = stat.S_IMODE(os.stat("bindings.lua", dir_fd=dirfd, follow_symlinks=False).st_mode)
    except FileNotFoundError:
        mode = 0o644
    write_atomic(dirfd, "bindings.lua", "\n".join(lines).encode("utf-8", "surrogateescape"), mode)


def _canon_chord(text):
    """'SUPER SHIFT CTRL + SPACE' or 'ctrl+space' -> 'SUPER + CTRL + SHIFT + SPACE'; None if malformed."""
    parts = [CHORD_ALIASES.get(p, p)
             for p in re.split(r"[\s+]+", str(text).upper()) if p]
    keys = [p for p in parts if p not in CHORD_MODS]
    if len(keys) != 1:
        return None
    return " + ".join([m for m in CHORD_MODS if m in parts] + keys)


def _hypr_socket_path():
    """Path to this Hyprland instance's IPC socket, or None."""
    runtime = os.environ.get("XDG_RUNTIME_DIR") or ""
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or ""
    if not runtime.startswith("/") or not sig or "/" in sig or sig in (".", ".."):
        return None
    return os.path.join(runtime, "hypr", sig, HYPR_SOCKET_NAME)


def _hypr_request(payload):
    """One bounded round trip to Hyprland's IPC socket. -> bytes, or None."""
    path = _hypr_socket_path()
    if path is None:
        return None
    try:
        st = os.stat(path)
    except OSError:
        return None
    if not stat.S_ISSOCK(st.st_mode) or st.st_uid != EUID:
        return None
    end = time.monotonic() + HYPR_BINDS_DEADLINE
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        try:
            sock.settimeout(HYPR_BINDS_DEADLINE)
            sock.connect(path)
            sock.sendall(payload)
        except OSError:
            return None
        chunks = []
        total = 0
        while True:
            remaining = end - time.monotonic()
            if remaining <= 0:
                return None
            try:
                sock.settimeout(remaining)
                chunk = sock.recv(65536)
            except OSError:
                return None
            if not chunk:
                return b"".join(chunks)
            total += len(chunk)
            if total > HYPR_BINDS_BYTES:
                return None
            chunks.append(chunk)
    finally:
        sock.close()


def _hypr_flag(record, name):
    """A `j/binds` boolean, which Hyprland writes as the string "true"."""
    value = record.get(name)
    if isinstance(value, bool):
        return value
    return isinstance(value, str) and value.strip().lower() == "true"


def _hypr_mods(record):
    """The modifier set of a `j/binds` record, in _chord_mods form."""
    modmask = record.get("modmask")
    if not isinstance(modmask, int) or isinstance(modmask, bool):
        return None
    named = [name for bit, name in HYPR_MODMASK if modmask & bit]
    return " + ".join([m for m in CHORD_MODS if m in named])


def _canon_hypr_bind(record):
    """One `j/binds` record -> canonical chord, or None if it names none."""
    key = record.get("key")
    modmask = record.get("modmask")
    if not isinstance(key, str) or not key or not isinstance(modmask, int):
        return None
    if isinstance(modmask, bool):
        # Not a mask Hyprland would send. Reading it as one would name a
        # chord this record does not hold, so it counts as a hole instead.
        return None
    mods = [name for bit, name in HYPR_MODMASK if modmask & bit]
    # A modmask bit outside HYPR_MODMASK (CapsLock, NumLock) makes the real
    # bind narrower than the chord named here. Naming it anyway can only
    # report a free chord as taken, which costs the user one manual choice.
    # Returning None instead is not a quiet drop: _bound_chords treats an
    # unnameable record as a hole in the table.
    return _canon_chord(" + ".join(mods + [key]))


def _print_chords():
    """Chords `omarchy-menu-keybindings --print` names, chord -> description.

    None means the run itself failed, which is not the same answer as an
    empty table: a table missing a bind Hyprland actually holds reads as a
    free chord, so the caller has to tell the two apart.
    """
    try:
        raw, truncated, status = run_bounded(
            ["omarchy-menu-keybindings", "--print"],
            BINDINGS_PRINT_BYTES, BINDINGS_PRINT_DEADLINE, want_status=True)
    except Denied:
        return None
    if truncated or status != 0:
        return None
    named = {}
    for line in raw.decode("utf-8", "replace").split("\n"):
        left, arrow, desc = line.partition("\u2192")
        chord = _canon_chord(left) if arrow else None
        if chord and chord not in named:
            named[chord] = clamp_text(desc, BINDINGS_DESC_CHARS).strip()
    return named


def _chord_mods(chord):
    """'SUPER + ALT + 9' -> 'SUPER + ALT'; a chord with no modifier -> ''."""
    parts = str(chord).split(" + ")
    return " + ".join([m for m in CHORD_MODS if m in parts])


def _bound_chords():
    """The live bind table. -> (chord -> description, unreliable mod sets).

    A bound table of None means the compositor did not answer, and callers
    must then leave every chord alone: an unanswered bind table is
    indistinguishable from an empty one, and an empty one reads as "every
    chord is free".

    The second value names the modifier sets the table cannot speak for,
    because Hyprland reported a bind under them that this reply does not let
    us name. Absence of a chord under one of those is not evidence the chord
    is free; absence under any other modifier set is.

    Two limits worth stating, since callers read absence as a fact. This
    answers for binds the compositor holds, not for shortcuts some other
    program grabs - the browser-extension chords in --print's static list
    reach the table only through the merge below, and vanish with it. And a
    bind carrying Hyprland's ignore_mods flag fires under modifier sets
    other than its own, which `j/binds` does not report in either format on
    0.56, so a modmask is taken at face value as the reach of its bind.
    """
    raw = _hypr_request(b"j/binds")
    if raw is None:
        return None, []
    try:
        records = json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return None, []
    if not isinstance(records, list) or not records:
        return None, []
    bound = {}
    unknown = set()
    for record in records:
        if not isinstance(record, dict):
            return None, []
        # A bind under a submap only fires after that submap is entered, so
        # it does not occupy the chord in the default map - unless it is
        # marked universal, which is exactly the flag that makes it fire
        # everywhere. Hyprland serializes that one as the string "true",
        # so Python truthiness would read "false" as yes.
        if record.get("submap") and not _hypr_flag(record, "submap_universal"):
            continue
        chord = _canon_hypr_bind(record)
        if chord is None:
            # A live bind this reply does not let us name - on Hyprland 0.56
            # every `SUPER + code:10` lands here. Its modifiers are still
            # known, so the damage is contained to them.
            mods = _hypr_mods(record)
            if mods is None:
                # Not even the modifiers. Nothing scopes the damage, so the
                # whole table stops being evidence.
                return None, []
            unknown.add(mods)
            continue
        if chord in bound:
            continue
        desc = record.get("description")
        bound[chord] = clamp_text(desc if isinstance(desc, str) else "",
                                  BINDINGS_DESC_CHARS).strip()
    if not bound:
        return None, []
    # --print is merged for what it can name, never to clear `unknown`: it
    # naming one chord under SUPER is no evidence it named every SUPER bind
    # the socket could not, and this is exactly where counting entries would
    # turn into a guess. An unreliable modifier set stays unreliable until
    # the compositor itself names those binds.
    for chord, desc in (_print_chords() or {}).items():
        if not bound.get(chord):
            bound[chord] = desc
    return bound, sorted(unknown)


def _strip_managed(lines):
    """Drop the managed block and the blank line before it. -> (lines, block contents)"""
    start = next((i for i, line in enumerate(lines) if line.strip() == MARK_START), None)
    if start is None:
        return lines, []
    end = next((i for i in range(start, len(lines)) if lines[i].strip() == MARK_END), None)
    if end is None:
        raise Denied("managed block in bindings.lua is not closed")
    block = lines[start + 1:end]
    if start and lines[start - 1].strip() == "":
        start -= 1
    return lines[:start] + lines[end + 1:], block


def _lua_call_end(lines, start):
    """Return the last line of an o.bind call, ignoring parentheses inside strings."""
    depth = 0
    quote = None
    escaped = False
    opened = False
    for end in range(start, len(lines)):
        line = lines[end]
        i = line.find("o.bind") if end == start else 0
        while i < len(line):
            char = line[i]
            if quote:
                if escaped:
                    escaped = False
                elif char == "\\":
                    escaped = True
                elif char == quote:
                    quote = None
            elif line.startswith("--", i):
                break
            elif char in "\"'":
                quote = char
            elif char == "(":
                depth += 1
                opened = True
            elif char == ")":
                depth -= 1
                if opened and depth == 0:
                    return end
            i += 1
    raise Denied("Spotlight binding in bindings.lua is not closed")


def _disable_toggle_calls(lines):
    """Comment every line of each live Spotlight toggle call."""
    lines = list(lines)
    i = 0
    while i < len(lines):
        match = TOGGLE_RE.match(lines[i])
        if not match:
            i += 1
            continue
        end = _lua_call_end(lines, i)
        if i:
            unbind = UNBIND_RE.match(lines[i - 1])
            if unbind and _canon_chord(unbind.group(1)) == _canon_chord(match.group("chord")):
                lines[i - 1] = DISABLED_PREFIX + lines[i - 1]
        for line_no in range(i, end + 1):
            lines[line_no] = DISABLED_PREFIX + lines[line_no]
        i = end + 1
    return lines


def cmd_read_binding():
    bound, unknown_mods = _bound_chords()
    reply = {"current": None, "previous": None, "managed": False,
             "bound": bound, "unknownMods": unknown_mods}
    try:
        fd = walk([".config", "hypr"])
    except FileNotFoundError:
        emit(reply)
        return
    try:
        lines = _bindings_lines(fd) or []
    finally:
        os.close(fd)
    for line in lines:
        if line.strip() == MARK_START:
            reply["managed"] = True
        elif line.startswith(DISABLED_PREFIX):
            old = TOGGLE_RE.match(line[len(DISABLED_PREFIX):])
            if old and reply["previous"] is None:
                reply["previous"] = old.group("chord")
        else:
            live = TOGGLE_RE.match(line)
            if live and reply["current"] is None:
                reply["current"] = live.group("chord")
    emit(reply)


def _chord_is_known(chord, bound, unknown_mods):
    """Whether `bound` can be trusted to say this chord is free."""
    return bound is not None and _chord_mods(chord) not in unknown_mods


def cmd_write_binding(argv):
    if len(argv) != 1 or "+" not in argv[0] or not CHORD_RE.match(argv[0]):
        raise Denied("bad chord")
    chord = argv[0]
    unbind = 'hl.unbind("%s")' % chord
    fd = _hypr_dir()
    try:
        original = _bindings_lines(fd)
        new_file = original is None
        lines = original or [""]
        own = {_canon_chord(m.group("chord")) for m in map(TOGGLE_RE.match, lines) if m}
        lines, block = _strip_managed(lines)
        lines = _disable_toggle_calls(lines)
        # Unbind a chord someone else holds, and keep an unbind the previous
        # block already carried: hyprctl reload rebuilds every default, so
        # "not bound right now" may only mean our own block removed it.
        bound, unknown_mods = _bound_chords()
        unbound = (any(line.strip() == unbind for line in block)
                   or not _chord_is_known(chord, bound, unknown_mods)
                   or (chord in bound and chord not in own))
        block = [MARK_START] + ([unbind] if unbound else []) + [
            'o.bind("%s", "Spotlight", "%s")' % (chord, TOGGLE_CMD), MARK_END]
        body = "\n".join(lines)
        trailing_newline = body.endswith("\n")
        if body:
            body += "\n" if trailing_newline else "\n\n"
        body += "\n".join(block)
        if trailing_newline or new_file:
            body += "\n"
        _write_bindings(fd, body.split("\n"))
    finally:
        os.close(fd)
    emit({"chord": chord, "unbound": unbound,
          "path": os.path.join(os.environ["HOME"], ".config", "hypr", "bindings.lua")})


def cmd_revert_binding():
    fd = _hypr_dir()
    try:
        original = _bindings_lines(fd)
        if original is None:
            emit({"restored": None})
            return
        lines, _ = _strip_managed(original)
        restored = None
        for i, line in enumerate(lines):
            if line.startswith(DISABLED_PREFIX):
                lines[i] = line = line[len(DISABLED_PREFIX):]
                live = TOGGLE_RE.match(line)
                if live and restored is None:
                    restored = live.group("chord")
        if lines != original:
            _write_bindings(fd, lines)
    finally:
        os.close(fd)
    emit({"restored": restored})


# name -> (handler, whether it reads positional arguments)
COMMANDS = {
    "read-settings": (cmd_read_settings, False),
    "ensure-settings": (cmd_ensure_settings, False),
    "ensure-data": (cmd_ensure_data, False),
    "reset-usage": (cmd_reset_usage, False),
    "read-usage": (cmd_read_usage, False),
    "read-hides": (cmd_read_hides, False),
    "read-menu-commands": (cmd_read_menu_commands, False),
    "write-usage": (cmd_write_usage, False),
    "read-clipboard": (cmd_read_clipboard, False),
    "clipboard-copy": (cmd_clipboard_copy, True),
    "reminders": (cmd_reminders, False),
    "toggle-states": (cmd_toggle_states, False),
    "suggest": (cmd_suggest, True),
    "files": (cmd_files, True),
    "tldr": (cmd_tldr, True),
    "write-ics": (cmd_write_ics, True),
    "write-settings": (cmd_write_settings, False),
    "read-binding": (cmd_read_binding, False),
    "write-binding": (cmd_write_binding, True),
    "revert-binding": (cmd_revert_binding, False),
}


def main(argv):
    signal.signal(signal.SIGINT, _handle_termination)
    signal.signal(signal.SIGTERM, _handle_termination)
    if not argv or argv[0] not in COMMANDS:
        sys.stdout.write(json.dumps({"ok": False, "error": "unknown command"}) + "\n")
        return 0
    handler, takes_args = COMMANDS[argv[0]]
    try:
        handler(argv[1:]) if takes_args else handler()
    except Denied as exc:
        sys.stdout.write(json.dumps({"ok": False, "error": str(exc)}) + "\n")
    except Exception as exc:  # never let a traceback become the payload
        sys.stdout.write(json.dumps({"ok": False, "error": type(exc).__name__}) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
